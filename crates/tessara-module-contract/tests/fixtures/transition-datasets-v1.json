{
  "schema_version": 1,
  "reserved_definition_id": "tessara.datasets",
  "display_name": "Datasets",
  "description": "Current in-process dataset authoring, publication, materialization, and preview contribution.",
  "availability": "active_in_process",
  "features": [
    {
      "id": "tessara.datasets.authoring",
      "name": "Dataset authoring",
      "description": "Author dataset definitions and revisions.",
      "use_cases": ["Create or revise a governed dataset definition."],
      "inputs": ["Dataset metadata, schema, source bindings, and classification settings."],
      "outcomes": ["A saved Dataset and editable DatasetRevision."],
      "constraints": ["Dataset classification and field policy remain Dataset-owned."],
      "contracts": ["tessara.datasets.dataset", "tessara.datasets.dataset-revision"],
      "resource_types": ["tessara.transition.dataset", "tessara.transition.dataset_revision"],
      "destinations": ["datasets.directory", "datasets.create", "datasets.edit"],
      "capabilities": ["datasets:manage"],
      "configuration_pointers": []
    },
    {
      "id": "tessara.datasets.publication",
      "name": "Dataset publication",
      "description": "Publish and inspect dataset revisions.",
      "use_cases": ["Publish a reviewed dataset revision for stable consumption."],
      "inputs": ["A valid DatasetRevision and its compatibility assessment."],
      "outcomes": ["A published DatasetRevision retained in revision history."],
      "constraints": ["Publication preserves current compatibility and lifecycle rules."],
      "contracts": ["tessara.datasets.dataset", "tessara.datasets.dataset-revision"],
      "resource_types": ["tessara.transition.dataset", "tessara.transition.dataset_revision"],
      "destinations": ["datasets.revisions", "datasets.revision_detail", "datasets.revision_edit"],
      "capabilities": ["datasets:manage"],
      "configuration_pointers": []
    },
    {
      "id": "tessara.datasets.materialization",
      "name": "Dataset materialization",
      "description": "Materialize a stable dataset major line from response data.",
      "use_cases": ["Build dataset rows from governed response and form-version data."],
      "inputs": ["Response records, exact FormVersion context, and a dataset revision."],
      "outcomes": ["Materialized data associated with a stable dataset major line."],
      "constraints": ["Materialization retains source provenance and classification policy."],
      "contracts": [
        "tessara.datasets.dataset-major-line",
        "tessara.datasets.materialization",
        "tessara.responses.response",
        "tessara.forms.form-version"
      ],
      "resource_types": ["tessara.transition.dataset_major_line"],
      "destinations": ["datasets.revisions"],
      "capabilities": ["datasets:manage"],
      "configuration_pointers": []
    },
    {
      "id": "tessara.datasets.preview",
      "name": "Dataset preview",
      "description": "Preview dataset data under its classification controls.",
      "use_cases": ["Inspect representative rows and schema before downstream use."],
      "inputs": ["A Dataset or DatasetRevision identifier and preview parameters."],
      "outcomes": ["A classification-filtered dataset preview."],
      "constraints": ["Restricted and confidential fields require their existing read capabilities."],
      "contracts": [
        "tessara.datasets.dataset",
        "tessara.datasets.dataset-revision",
        "tessara.datasets.dataset-major-line"
      ],
      "resource_types": [
        "tessara.transition.dataset",
        "tessara.transition.dataset_revision",
        "tessara.transition.dataset_major_line"
      ],
      "destinations": ["datasets.detail", "datasets.preview"],
      "capabilities": ["datasets:read", "datasets:read_restricted", "datasets:read_confidential"],
      "configuration_pointers": []
    }
  ],
  "provided_contracts": [
    {"id": "tessara.datasets.dataset", "version": "1.0.0", "kind": "resource", "description": "Resolve a Dataset."},
    {"id": "tessara.datasets.dataset-revision", "version": "1.0.0", "kind": "resource", "description": "Resolve a DatasetRevision."},
