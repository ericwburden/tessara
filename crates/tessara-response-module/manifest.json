  "features": [
    {
      "id": "tessara.responses.start",
      "name": "Start response",
      "description": "Start assigned response work from an authenticated Workflow context.",
      "use_cases": ["Start an assigned response"],
      "inputs": ["Workflow assignment context", "FormVersion schema"],
      "outcomes": ["Draft Response"],
      "constraints": ["Assignment-only start"],
      "contracts": ["tessara.responses.response", "tessara.responses.response-lifecycle", "tessara.responses.start-reconciliation"],
      "resource_types": ["tessara.responses.response"],
      "destinations": ["responses.start"],
      "capabilities": ["submissions:respond"],
      "configuration_pointers": ["/properties/provider_request_timeout_seconds"]
    },
    {
      "id": "tessara.responses.manage",
      "name": "Response lifecycle",
      "description": "List, edit, submit, and review Responses.",
      "use_cases": ["Save a draft", "Submit a response", "Review scoped responses"],
      "inputs": ["Pinned source snapshots", "Response values"],
      "outcomes": ["Durable Response lifecycle and exports"],
      "constraints": ["Owner and scope authorization"],
      "contracts": ["tessara.responses.response", "tessara.responses.response-lifecycle", "tessara.responses.submitted-response-export", "tessara.responses.response-events"],
      "resource_types": ["tessara.responses.response"],
      "destinations": ["responses.directory", "responses.detail", "responses.edit"],
      "capabilities": ["submissions:read_own", "submissions:respond", "submissions:manage"],
      "configuration_pointers": ["/properties/workflow_event_page_size"]
    }
