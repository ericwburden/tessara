        "image_reference": "registry.example/tessara/response-module@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "platform": "linux",
        "architecture": "amd64",
        "command": ["/usr/local/bin/response-module", "migrate"]
      },
      "listen": { "protocol": "http", "port": 8094, "registration_name": "responses" },
