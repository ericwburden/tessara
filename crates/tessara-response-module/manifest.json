    { "destination": "responses.directory", "path_template": "/responses", "methods": ["GET", "HEAD"], "required_capability": "submissions:read_own", "authorization_action": "responses.list", "dependency_binding": "tessara.core.module-document", "functional_contract": "tessara.responses.response-lifecycle", "organization_scope_parameter": null },
