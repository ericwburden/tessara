    { "destination": "responses.detail", "path_template": "/responses/{response_id}", "methods": ["GET", "HEAD"], "required_capability": "submissions:read_own", "authorization_action": "responses.get", "dependency_binding": "tessara.core.module-document", "functional_contract": "tessara.responses.response-lifecycle", "organization_scope_parameter": null }
