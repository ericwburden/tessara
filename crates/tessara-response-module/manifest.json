    { "id": "tessara.responses.response-lifecycle", "version": "2.0.0", "kind": "behavior", "description": "Start, save, submit, and review Responses." },
    { "id": "tessara.responses.submitted-response-export", "version": "1.0.0", "kind": "api", "description": "Fixed-bound submitted Response export." },
    { "id": "tessara.responses.response-events", "version": "1.0.0", "kind": "event", "description": "Ordered Workflow lifecycle events." },
    { "id": "tessara.responses.start-reconciliation", "version": "1.0.0", "kind": "api", "description": "Race-safe Workflow start reservation reconciliation." },
    { "id": "tessara.responses.form-version-usage", "version": "1.0.0", "kind": "behavior", "description": "Authorized reverse usage for Forms." },
    { "id": "tessara.responses.summary", "version": "1.0.0", "kind": "behavior", "description": "Scoped Response summary." },
    { "id": "tessara.responses.operational-status", "version": "1.0.0", "kind": "behavior", "description": "Sanitized Response owner status." },
    { "id": "tessara.responses.resource-observation", "version": "1.0.0", "kind": "behavior", "description": "Authorized Response resource observation." }
