    { "name": "responses.edit", "kind": "product", "parameters": [{ "name": "response_id", "value_type": "uuid", "required": true }] },
    { "name": "tessara.responses.configuration.validate", "kind": "configuration", "parameters": [] },
    { "name": "tessara.responses.compatibility", "kind": "diagnostics", "parameters": [] },
    { "name": "tessara.responses.status", "kind": "diagnostics", "parameters": [] },
    { "name": "tessara.responses.diagnostics", "kind": "diagnostics", "parameters": [] }
