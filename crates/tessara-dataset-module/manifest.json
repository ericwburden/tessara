  "features": [
    {
      "id": "tessara.datasets.authoring",
      "name": "Dataset authoring and materialization",
      "description": "Author, publish, refresh, and inspect module-owned Datasets.",
      "use_cases": [
        "Create and materialize Datasets from declared providers."
      ],
      "inputs": [
        "Typed provider contracts and Dataset definitions."
      ],
      "outcomes": [
        "Published Dataset resources and materialized major lines."
      ],
      "constraints": [
        "Source data is imported only through declared provider contracts."
      ],
      "contracts": [
        "tessara.datasets.dataset",
        "tessara.datasets.dataset-revision",
        "tessara.datasets.dataset-major-line"
      ],
      "resource_types": [
        "tessara.datasets.dataset",
        "tessara.datasets.dataset_revision",
        "tessara.datasets.dataset_major_line"
      ],
      "destinations": [
        "datasets.directory",
        "datasets.create",
        "datasets.detail",
        "datasets.edit",
        "datasets.revisions",
        "datasets.revision_detail",
        "datasets.revision_edit"
      ],
      "capabilities": [
        "datasets:manage"
      ],
      "configuration_pointers": [
        "/properties/provider_request_timeout_seconds",
        "/properties/provider_retry_limit",
        "/properties/response_export_page_size"
      ]
    },
    {
      "id": "tessara.datasets.execution",
      "name": "Dataset execution",
      "description": "Resolve and execute authorized Dataset major lines.",
      "use_cases": [
        "Preview or consume a published Dataset."
      ],
      "inputs": [
        "An exact Dataset major-line reference and authorized scope."
      ],
      "outcomes": [
        "Bounded materialized rows."
      ],
      "constraints": [
        "Restricted references remain non-disclosing."
      ],
      "contracts": [
        "tessara.datasets.dataset-major-line"
      ],
      "resource_types": [
        "tessara.datasets.dataset_major_line"
      ],
      "destinations": [
        "datasets.directory",
        "datasets.detail",
        "datasets.preview"
      ],
      "capabilities": [
        "datasets:read"
      ],
      "configuration_pointers": []
    }
  ],
