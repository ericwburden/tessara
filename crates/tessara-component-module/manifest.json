  "resource_types": [
    {"id":"tessara.components.component_version","description":"A versioned presentation resource owned by the Component Module Instance."}
  ],
  "typed_reference_schemas": [
    {"resource_type":"tessara.components.component_version","resource_id":{"format":"uuid"}}
  ],
  "routes": [
    {"name":"components.directory","kind":"product","parameters":[]},
    {"name":"components.create","kind":"product","parameters":[]},
    {"name":"components.detail","kind":"product","parameters":[{"name":"component_ref","value_type":"string","required":true}]},
    {"name":"components.edit","kind":"product","parameters":[{"name":"component_ref","value_type":"string","required":true}]},
