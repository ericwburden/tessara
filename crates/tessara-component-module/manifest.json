  "features": [
    {
      "id": "tessara.components.authoring",
      "name": "Component authoring",
      "description": "Author and publish versioned presentation Components over typed Dataset major lines.",
      "use_cases": ["Create, revise, publish, and manage Component lifecycle."],
      "inputs": ["Component configuration and a typed Dataset major-line reference."],
      "outcomes": ["A reusable ComponentVersion resource."],
      "constraints": ["Dataset data is consumed only through the declared Dataset contract."],
      "contracts": ["tessara.components.component-version", "tessara.datasets.dataset-major-line"],
      "resource_types": ["tessara.components.component_version"],
      "destinations": ["components.directory", "components.create", "components.edit", "components.versions"],
      "capabilities": ["components:manage"],
      "configuration_pointers": ["/properties/dataset_request_timeout_seconds"]
    },
    {
      "id": "tessara.components.viewing",
      "name": "Component viewing",
      "description": "Resolve and execute authorized ComponentVersions.",
      "use_cases": ["Browse and render a Component."],
      "inputs": ["An exact ComponentVersion reference and authorized actor context."],
      "outcomes": ["A rendered table, chart, or statistic."],
      "constraints": ["Restricted references remain non-disclosing."],
      "contracts": ["tessara.components.component-version"],
      "resource_types": ["tessara.components.component_version"],
      "destinations": ["components.directory", "components.detail", "components.view"],
      "capabilities": ["components:read"],
      "configuration_pointers": []
    }
  ],
  "provided_contracts": [
    {"id":"tessara.components.component-version","version":"3.0.0","kind":"resource","description":"Resolve and execute a ComponentVersion owned by this Module Instance."},
    {"id":"tessara.components.authoring","version":"1.0.0","kind":"behavior","description":"Create, publish, and manage module-owned Component versions."}
  ],
