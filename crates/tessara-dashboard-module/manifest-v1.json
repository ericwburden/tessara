{
  "schema_version": 1,
  "definition_id": "tessara.dashboards",
  "release_version": "1.0.0",
  "publisher": "tessara.first_party",
  "support": {
    "support_tier": "first_party",
    "contact": "support@tessara.example",
    "documentation": "https://docs.tessara.example/modules/dashboards"
  },
  "conformance_suite_version": "1.0.0",
  "core_release_compatibility": "^0.1",
  "shell_context_compatibility": "^1",
  "ui_sdk_compatibility": "^1",
  "design_system_compatibility": "^1",
  "deployment": {
    "profile": "tessara-oci-v1",
    "declaration": {
      "runtime_image": {
        "image_reference": "registry.example/tessara/dashboards@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "platform": "linux",
        "architecture": "amd64",
        "command": ["/app/dashboard-module", "serve"]
      },
      "migration_image": {
        "image_reference": "registry.example/tessara/dashboards@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "platform": "linux",
        "architecture": "amd64",
        "command": ["/app/dashboard-module", "migrate"]
      },
      "listen": {
        "protocol": "http",
        "port": 8091,
        "registration_name": "dashboards"
      },
      "configuration_keys": ["DISPLAY_LABEL", "DEFAULT_PAGE_SIZE"],
      "secret_keys": ["DATABASE_URL"],
      "runtime_identity": "dashboards-runtime",
      "migration_identity": "dashboards-migration",
      "readiness_path": "/health/ready",
      "liveness_path": "/health/live",
      "graceful_shutdown_seconds": 30,
      "resources": {
        "cpu_request_millis": 150,
        "cpu_limit_millis": 500,
        "memory_request_mebibytes": 96,
        "memory_limit_mebibytes": 256
      }
    }
  },
  "features": [
    {
      "id": "tessara.dashboards.composition",
      "name": "Dashboard composition",
      "description": "Compose a Dashboard from exact typed ComponentVersion references.",
      "use_cases": ["Create or revise a Dashboard layout from reusable Components."],
      "inputs": ["Dashboard metadata, layout, and exact ComponentVersion references."],
      "outcomes": ["A saved Dashboard composition."],
      "constraints": [
        "Composition retains exact ComponentVersion references.",
        "The transition Components binding must be migrated explicitly in Sprint 8A."
      ],
      "contracts": [
        "tessara.dashboards.dashboard",
        "tessara.dashboards.composition",
        "tessara.components.component-version"
      ],
      "resource_types": ["tessara.dashboards.dashboard"],
      "destinations": ["dashboards.create", "dashboards.edit"],
      "capabilities": ["dashboards:manage"],
      "configuration_pointers": ["/properties/default_page_size"]
    },
    {
      "id": "tessara.dashboards.viewing",
      "name": "Dashboard viewing",
      "description": "Inspect and view an authorized Dashboard.",
      "use_cases": ["Browse and open a Dashboard."],
      "inputs": ["Dashboard identity and authorized actor context."],
      "outcomes": ["A rendered Dashboard with contained placement states."],
      "constraints": ["Restricted Component references are non-disclosing."],
      "contracts": ["tessara.dashboards.dashboard"],
      "resource_types": ["tessara.dashboards.dashboard"],
      "destinations": ["dashboards.directory", "dashboards.detail", "dashboards.view"],
      "capabilities": ["dashboards:read"],
      "configuration_pointers": []
    }
  ],
  "provided_contracts": [
    {
      "id": "tessara.dashboards.dashboard",
      "version": "1.0.0",
      "kind": "resource",
      "description": "Resolve a Dashboard owned by one Dashboard Module Instance."
    },
    {
      "id": "tessara.dashboards.composition",
      "version": "1.0.0",
      "kind": "behavior",
      "description": "Create and reconcile Dashboard composition."
    }
  ],
  "dependencies": [
    {
      "contract_id": "tessara.components.component-version",
      "version_requirement": "^1.0",
      "binding_key": "tessara.dashboards.component-version",
      "optional": false
    }
  ],
  "resource_types": [
    {
      "id": "tessara.dashboards.dashboard",
      "description": "A Dashboard owned by one Dashboard Module Instance."
    }
  ],
  "typed_reference_schemas": [
    {
      "resource_type": "tessara.dashboards.dashboard",
      "resource_id": {
        "format": "uuid"
      }
    }
  ],
  "routes": [
    {"name": "dashboards.directory", "kind": "product", "parameters": []},
    {"name": "dashboards.create", "kind": "product", "parameters": []},
    {
      "name": "dashboards.detail",
      "kind": "product",
      "parameters": [{"name": "dashboard_id", "value_type": "uuid", "required": true}]
    },
    {
      "name": "dashboards.edit",
      "kind": "product",
      "parameters": [{"name": "dashboard_id", "value_type": "uuid", "required": true}]
    },
    {
      "name": "dashboards.view",
      "kind": "product",
      "parameters": [{"name": "dashboard_id", "value_type": "uuid", "required": true}]
    },
    {"name": "dashboards.configuration.validate", "kind": "configuration", "parameters": []},
    {"name": "dashboards.compatibility", "kind": "diagnostics", "parameters": []},
    {"name": "dashboards.status", "kind": "diagnostics", "parameters": []},
    {"name": "dashboards.diagnostics", "kind": "diagnostics", "parameters": []}
  ],
  "navigation": [
    {
      "id": "tessara.dashboards.navigation",
      "destination": "dashboards.directory",
      "label": "Dashboards",
      "group": "Main",
      "order_hint": 70,
      "required_capabilities_any_of": ["dashboards:read"]
    }
  ],
  "security_capabilities": [
    {"id": "dashboards:read", "description": "Inspect Dashboard definitions."},
    {"id": "dashboards:manage", "description": "Manage Dashboard definitions."}
  ],
  "configuration_schema": {
    "type": "object",
    "properties": {
      "display_label": {"type": "string", "minLength": 1, "maxLength": 80},
      "default_page_size": {"type": "integer", "minimum": 10, "maximum": 100}
    },
    "required": ["display_label", "default_page_size"],
    "additionalProperties": false
  },
  "operational_routes": {
    "configuration_validation": "dashboards.configuration.validate",
    "compatibility": "dashboards.compatibility",
    "status": "dashboards.status",
    "diagnostics": "dashboards.diagnostics"
  },
  "shell_contribution_contracts": null
}
