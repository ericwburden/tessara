  "features": [
    {
      "id": "tessara.dashboards.composition",
      "name": "Dashboard composition",
      "description": "Compose a Dashboard from exact typed ComponentVersion references.",
      "use_cases": [
        "Create or revise a Dashboard layout from reusable Components."
      ],
      "inputs": [
        "Dashboard metadata, layout, and exact ComponentVersion references."
      ],
      "outcomes": [
        "A saved Dashboard composition."
      ],
      "constraints": [
        "Composition retains exact ComponentVersion references owned by the selected Component Module Instance."
      ],
      "contracts": [
        "tessara.dashboards.dashboard",
        "tessara.dashboards.composition",
        "tessara.components.component-version"
      ],
      "resource_types": [
        "tessara.dashboards.dashboard"
      ],
      "destinations": [
        "dashboards.create",
        "dashboards.edit"
      ],
      "capabilities": [
        "dashboards:manage"
      ],
      "configuration_pointers": [
        "/properties/default_page_size"
      ]
    },
    {
      "id": "tessara.dashboards.viewing",
      "name": "Dashboard viewing",
      "description": "Inspect and view an authorized Dashboard.",
      "use_cases": [
        "Browse and open a Dashboard."
      ],
      "inputs": [
        "Dashboard identity and authorized actor context."
      ],
      "outcomes": [
        "A rendered Dashboard with contained placement states."
      ],
      "constraints": [
        "Restricted Component references are non-disclosing."
      ],
      "contracts": [
        "tessara.dashboards.dashboard"
      ],
      "resource_types": [
        "tessara.dashboards.dashboard"
      ],
