    {
      "name": "dashboards.configuration.validate",
      "kind": "configuration",
      "parameters": []
    },
    {
      "name": "dashboards.compatibility",
      "kind": "diagnostics",
      "parameters": []
    },
    {
      "name": "dashboards.status",
      "kind": "diagnostics",
      "parameters": []
    },
    {
      "name": "dashboards.diagnostics",
      "kind": "diagnostics",
      "parameters": []
    }
  ],
  "navigation": [
    {
      "id": "tessara.dashboards.navigation",
      "destination": "dashboards.directory",
      "label": "Dashboards",
      "group": "Main",
      "order_hint": 70,
      "required_capabilities_any_of": [
        "dashboards:read"
      ]
    }
  ],
  "security_capabilities": [
    {
      "id": "dashboards:read",
      "description": "Inspect Dashboard definitions."
    },
    {
      "id": "dashboards:manage",
      "description": "Manage Dashboard definitions."
    }
  ],
  "configuration_schema": {
    "type": "object",
    "properties": {
      "display_label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "default_page_size": {
        "type": "integer",
        "minimum": 10,
        "maximum": 100
      }
