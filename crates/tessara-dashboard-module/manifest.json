{
  "schema_version": 3,
  "definition_id": "tessara.dashboards",
  "release_version": "2.0.2",
  "publisher": "tessara.first_party",
  "support": {
    "support_tier": "first_party",
    "contact": "support@tessara.example",
    "documentation": "https://docs.tessara.example/modules/dashboards"
  },
  "deployment": {
    "profile": "tessara-oci-v1",
    "declaration": {
      "runtime_image": {
        "image_reference": "registry.example/tessara/dashboards@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "platform": "linux",
        "architecture": "amd64",
        "command": [
          "/app/dashboard-module",
          "serve"
        ]
      },
      "migration_image": {
        "image_reference": "registry.example/tessara/dashboards@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "platform": "linux",
        "architecture": "amd64",
        "command": [
          "/app/dashboard-module",
          "migrate"
        ]
      },
      "listen": {
        "protocol": "http",
        "port": 8091,
        "registration_name": "dashboards"
      },
      "configuration_keys": [
        "DISPLAY_LABEL",
        "DEFAULT_PAGE_SIZE"
      ],
      "secret_keys": [
        "DATABASE_URL"
      ],
      "runtime_identity": "dashboards-runtime",
      "migration_identity": "dashboards-migration",
      "readiness_path": "/health/ready",
      "liveness_path": "/health/live",
      "graceful_shutdown_seconds": 30,
      "resources": {
        "cpu_request_millis": 150,
        "cpu_limit_millis": 500,
        "memory_request_mebibytes": 96,
        "memory_limit_mebibytes": 256
      }
    }
  },
  "features": [
    {
      "id": "tessara.dashboards.composition",
      "name": "Dashboard composition",
      "description": "Compose a Dashboard from exact typed ComponentVersion references.",
      "use_cases": [
        "Create or revise a Dashboard layout from reusable Components."
      ],
      "inputs": [
        "Dashboard metadata, layout, and exact ComponentVersion references."
      ],
      "outcomes": [
        "A saved Dashboard composition."
      ],
      "constraints": [
        "Composition retains exact ComponentVersion references.",
        "The transition Components binding must be migrated explicitly in Sprint 8A."
      ],
      "contracts": [
        "tessara.dashboards.dashboard",
        "tessara.dashboards.composition",
        "tessara.components.component-version"
      ],
      "resource_types": [
        "tessara.dashboards.dashboard"
      ],
      "destinations": [
        "dashboards.create",
        "dashboards.edit"
      ],
      "capabilities": [
        "dashboards:manage"
      ],
      "configuration_pointers": [
        "/properties/default_page_size"
      ]
    },
    {
      "id": "tessara.dashboards.viewing",
      "name": "Dashboard viewing",
      "description": "Inspect and view an authorized Dashboard.",
      "use_cases": [
        "Browse and open a Dashboard."
      ],
      "inputs": [
        "Dashboard identity and authorized actor context."
      ],
      "outcomes": [
        "A rendered Dashboard with contained placement states."
      ],
      "constraints": [
        "Restricted Component references are non-disclosing."
      ],
      "contracts": [
        "tessara.dashboards.dashboard"
      ],
      "resource_types": [
        "tessara.dashboards.dashboard"
      ],
      "destinations": [
        "dashboards.directory",
        "dashboards.detail",
        "dashboards.view"
      ],
      "capabilities": [
        "dashboards:read"
      ],
      "configuration_pointers": []
    }
  ],
  "provided_contracts": [
    {
      "id": "tessara.dashboards.dashboard",
      "version": "1.0.0",
      "kind": "resource",
      "description": "Resolve a Dashboard owned by one Dashboard Module Instance."
    },
    {
      "id": "tessara.dashboards.composition",
      "version": "1.0.0",
      "kind": "behavior",
      "description": "Create and reconcile Dashboard composition."
    }
  ],
  "dependencies": [
    {
      "contract_id": "tessara.components.component-version",
      "version_requirement": "^1.0",
      "binding_key": "tessara.dashboards.component-version",
      "optional": false
    }
  ],
  "resource_types": [
    {
      "id": "tessara.dashboards.dashboard",
      "description": "A Dashboard owned by one Dashboard Module Instance."
    }
  ],
  "typed_reference_schemas": [
    {
      "resource_type": "tessara.dashboards.dashboard",
      "resource_id": {
        "format": "uuid"
      }
    }
  ],
  "routes": [
    {
      "name": "dashboards.directory",
