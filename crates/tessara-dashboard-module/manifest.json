  "public_api_routes": [
    {"path_template":"/api/dashboards","method":"GET","required_capability":"dashboards:read","authorization_action":"dashboards.list","dependency_binding":"tessara.core.dashboards","operation":"read","functional_contract":"tessara.dashboards.dashboard","idempotency":"none"},
    {"path_template":"/api/dashboards/{dashboard_id}","method":"GET","required_capability":"dashboards:read","authorization_action":"dashboards.get","dependency_binding":"tessara.core.dashboards","operation":"read","functional_contract":"tessara.dashboards.dashboard","idempotency":"none"},
    {"path_template":"/api/admin/dashboards","method":"POST","required_capability":"dashboards:manage","authorization_action":"dashboards.create","dependency_binding":"tessara.core.dashboards","operation":"mutation","functional_contract":"tessara.dashboards.dashboard","idempotency":"forward_or_generate_header"},
    {"path_template":"/api/admin/dashboards/visibility-nodes","method":"GET","required_capability":"dashboards:manage","authorization_action":"dashboards.list_manageable","dependency_binding":"tessara.core.dashboards","operation":"read","functional_contract":"tessara.dashboards.dashboard","idempotency":"none"},
    {"path_template":"/api/admin/dashboards/{dashboard_id}","method":"PUT","required_capability":"dashboards:manage","authorization_action":"dashboards.update","dependency_binding":"tessara.core.dashboards","operation":"mutation","functional_contract":"tessara.dashboards.dashboard","idempotency":"forward_or_generate_header"},
    {"path_template":"/api/admin/dashboards/{dashboard_id}","method":"DELETE","required_capability":"dashboards:manage","authorization_action":"dashboards.delete","dependency_binding":"tessara.core.dashboards","operation":"mutation","functional_contract":"tessara.dashboards.dashboard","idempotency":"forward_or_generate_header"},
    {"path_template":"/api/admin/dashboards/{dashboard_id}/composition","method":"GET","required_capability":"dashboards:manage","authorization_action":"dashboards.load_composition","dependency_binding":"tessara.core.dashboards","operation":"read","functional_contract":"tessara.dashboards.composition","idempotency":"none"},
    {"path_template":"/api/admin/dashboards/{dashboard_id}/composition","method":"PUT","required_capability":"dashboards:manage","authorization_action":"dashboards.reconcile_composition","dependency_binding":"tessara.core.dashboards","operation":"mutation","functional_contract":"tessara.dashboards.composition","idempotency":"forward_or_generate_header"}
  ],
