      "parameters": []
    },
    {
      "name": "dashboards.create",
      "kind": "product",
      "parameters": []
    },
    {
      "name": "dashboards.detail",
      "kind": "product",
      "parameters": [
        {
          "name": "dashboard_id",
          "value_type": "uuid",
          "required": true
        }
      ]
    },
    {
      "name": "dashboards.edit",
      "kind": "product",
      "parameters": [
        {
          "name": "dashboard_id",
          "value_type": "uuid",
          "required": true
        }
      ]
    },
    {
      "name": "dashboards.view",
      "kind": "product",
      "parameters": [
        {
          "name": "dashboard_id",
          "value_type": "uuid",
          "required": true
        }
