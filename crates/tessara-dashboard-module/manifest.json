      "functional_contract": "tessara.dashboards.composition",
      "organization_scope_parameter": null
    },
    {
      "destination": "dashboards.view",
      "path_template": "/dashboards/{dashboard_id}/view",
      "methods": ["GET", "HEAD"],
      "required_capability": "dashboards:read",
      "authorization_action": "dashboards.get",
      "dependency_binding": "tessara.core.dashboards",
      "functional_contract": "tessara.dashboards.dashboard",
      "organization_scope_parameter": null
    }
  ],
  "browser_lifecycle": {
    "lifecycle_abi": "1.0.0",
    "entry_asset": "/dashboard.js",
    "stylesheet_assets": ["/dashboard-lifecycle.css"],
    "complete_document_fallback": true,
    "capabilities": {
      "navigation_guard": true,
      "suspend_resume": true
    }
