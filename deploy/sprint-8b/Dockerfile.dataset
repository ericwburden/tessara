FROM rust:1.94-bookworm AS builder
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --locked -p tessara-dataset-module \
        --features sprint-8b-validation-faults \
    && cp /app/target/release/tessara-dataset-module /tmp/dataset-module

FROM debian:trixie-slim
ARG TESSARA_SOURCE_COMMIT=unknown
ARG TESSARA_SOURCE_TREE=unknown
ARG TESSARA_SOURCE_DIRTY=unknown
ARG TESSARA_DATASET_RELEASE=1.0.0

LABEL org.opencontainers.image.revision="$TESSARA_SOURCE_COMMIT" \
      com.tessara.source-tree="$TESSARA_SOURCE_TREE" \
      com.tessara.source-dirty="$TESSARA_SOURCE_DIRTY" \
      com.tessara.build-profile="release" \
      com.tessara.module-definition="tessara.datasets" \
      com.tessara.module-release="$TESSARA_DATASET_RELEASE"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /tmp/dataset-module /usr/local/bin/dataset-module
EXPOSE 8093
ENTRYPOINT ["dataset-module"]
