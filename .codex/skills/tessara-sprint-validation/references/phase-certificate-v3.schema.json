{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/phase-certificate-v3.json",
  "title": "Tessara platform-authenticated phase certificate v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_version", "platform_identity", "validation_adapter", "sprint", "phase", "attempt", "state", "authoritative", "certified_at", "source_identity", "environment_fingerprint", "candidate_fingerprint", "compatibility_plan", "successor_impact_plan", "prerequisite_certificates", "dependency_fingerprints", "coverage", "lanes", "open_defect_count", "cleanup_restoration", "evidence_index"],
  "properties": {
    "schema_version": { "const": 3 },
    "contract": { "const": "tessara.validation.phase-certificate" },
    "policy_version": { "const": "tessara-validation-v3" },
    "platform_identity": { "type": "object", "additionalProperties": false, "required": ["release_version", "platform_fingerprint"], "properties": { "release_version": { "const": "2.0.0" }, "platform_fingerprint": { "$ref": "#/$defs/sha" } } },
    "validation_adapter": { "$ref": "#/$defs/ref" },
    "sprint": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["validation-readiness", "candidate-rehearsal", "validation-preflight", "sit", "uat"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["passed", "failed"] },
    "authoritative": { "type": "boolean" },
    "certified_at": { "type": "string", "format": "date-time" },
    "source_identity": { "$ref": "#/$defs/source" },
    "environment_fingerprint": { "$ref": "#/$defs/sha" },
    "candidate_fingerprint": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
    "compatibility_plan": { "$ref": "#/$defs/ref" },
    "successor_impact_plan": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "prerequisite_certificates": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
    "dependency_fingerprints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["declared_lanes_sha256", "lane_count", "executed_count", "inherited_count"], "properties": { "declared_lanes_sha256": { "$ref": "#/$defs/sha" }, "lane_count": { "type": "integer", "minimum": 1 }, "executed_count": { "type": "integer", "minimum": 0 }, "inherited_count": { "type": "integer", "minimum": 0 } } },
    "lanes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lane" } },
    "open_defect_count": { "type": "integer", "minimum": 0 },
    "cleanup_restoration": { "$ref": "#/$defs/cleanup" },
    "evidence_index": { "$ref": "#/$defs/ref" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty"], "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "dirty": { "type": "boolean" }, "branch": { "type": "string" } } },
    "fingerprint": { "type": "object", "additionalProperties": false, "required": ["domain", "sha256"], "properties": { "domain": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "lane": { "type": "object", "additionalProperties": false, "required": ["name", "state", "certification_basis", "compatibility_fingerprint", "dependency_domains", "receipt", "started_at", "ended_at", "duration_ms", "inheritance"], "properties": { "name": { "$ref": "#/$defs/id" }, "state": { "enum": ["passed", "failed", "blocked"] }, "certification_basis": { "enum": ["executed", "inherited_nonimpact"] }, "compatibility_fingerprint": { "$ref": "#/$defs/sha" }, "dependency_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "receipt": { "$ref": "#/$defs/ref" }, "started_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }, "ended_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }, "duration_ms": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] }, "inheritance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/inheritance" }] } } },
    "inheritance": { "type": "object", "additionalProperties": false, "required": ["prior_certificate", "prior_receipt", "predecessor_candidate_fingerprint", "prior_compatibility_fingerprint", "current_compatibility_fingerprint", "prior_inheritance_fingerprint", "current_inheritance_fingerprint", "prior_dependency_fingerprints", "non_impact_rationale"], "properties": { "prior_certificate": { "$ref": "#/$defs/ref" }, "prior_receipt": { "$ref": "#/$defs/ref" }, "predecessor_candidate_fingerprint": { "$ref": "#/$defs/sha" }, "prior_compatibility_fingerprint": { "$ref": "#/$defs/sha" }, "current_compatibility_fingerprint": { "$ref": "#/$defs/sha" }, "prior_inheritance_fingerprint": { "$ref": "#/$defs/sha" }, "current_inheritance_fingerprint": { "$ref": "#/$defs/sha" }, "prior_dependency_fingerprints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fingerprint" } }, "non_impact_rationale": { "type": "string", "minLength": 1 } } },
    "cleanup": { "type": "object", "additionalProperties": false, "required": ["required", "state", "evidence"], "properties": { "required": { "type": "boolean" }, "state": { "enum": ["passed", "failed", "not_applicable"] }, "evidence": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] } } }
  }
}
