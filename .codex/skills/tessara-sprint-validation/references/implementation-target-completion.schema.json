{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/implementation-target-completion-v2.json",
  "title": "Tessara implementation target completion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_version", "sprint", "schedule_digest", "ordinal", "target", "lane", "priority_group", "disposition", "state", "reason", "newly_executed", "source_identity", "validation_contract", "validation_adapter", "platform_identity", "compatibility_fingerprint", "command_identity", "dependency_fingerprints", "environment_fingerprint", "prerequisite_closure", "resource_claims", "lane_result", "reused_receipt", "cleanup_restoration"],
  "properties": {
    "schema_version": { "const": 2 },
    "contract": { "const": "tessara.validation.implementation-target-receipt" },
    "policy_version": { "const": "tessara-validation-v3" },
    "sprint": { "$ref": "#/$defs/id" },
    "schedule_digest": { "$ref": "#/$defs/sha" },
    "ordinal": { "type": "integer", "minimum": 1 },
    "target": { "$ref": "#/$defs/id" },
    "lane": { "$ref": "#/$defs/id" },
    "priority_group": { "type": "integer", "minimum": 1, "maximum": 4 },
    "disposition": { "enum": ["executed", "reused", "blocked"] },
    "state": { "enum": ["passed", "failed", "blocked"] },
    "reason": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "newly_executed": { "type": "boolean" },
    "source_identity": { "type": "object" },
    "validation_contract": { "$ref": "#/$defs/ref" },
    "validation_adapter": { "$ref": "#/$defs/ref" },
    "platform_identity": { "$ref": "#/$defs/platform" },
    "compatibility_fingerprint": { "$ref": "#/$defs/sha" },
    "command_identity": { "$ref": "#/$defs/sha" },
    "dependency_fingerprints": { "type": "array", "items": { "type": "object" } },
    "environment_fingerprint": { "$ref": "#/$defs/sha" },
    "prerequisite_closure": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "compatibility_fingerprint", "receipt"],
        "properties": {
          "target": { "$ref": "#/$defs/id" },
          "compatibility_fingerprint": { "$ref": "#/$defs/sha" },
          "receipt": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "resource_claims": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "lane_result": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "reused_receipt": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "cleanup_restoration": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "state"],
      "properties": { "required": { "type": "boolean" }, "state": { "enum": ["passed", "failed", "blocked", "not_applicable"] } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "platform": { "type": "object", "additionalProperties": false, "required": ["release_version", "platform_fingerprint", "execution_fingerprint"], "properties": { "release_version": { "const": "2.0.0" }, "platform_fingerprint": { "$ref": "#/$defs/sha" }, "execution_fingerprint": { "$ref": "#/$defs/sha" } } }
  }
}
