{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://tessara.local/schemas/implementation-target-start-v1.json", "title": "Tessara implementation target start receipt",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "contract", "policy_version", "sprint", "schedule_digest", "ordinal", "target", "lane", "priority_group", "planned_disposition", "new_execution", "resource_claims"],
  "properties": { "schema_version": { "const": 1 }, "contract": { "const": "tessara.validation.implementation-target-start" }, "policy_version": { "const": "tessara-validation-v3" }, "sprint": { "$ref": "#/$defs/id" }, "schedule_digest": { "$ref": "#/$defs/sha" }, "ordinal": { "type": "integer", "minimum": 1 }, "target": { "$ref": "#/$defs/id" }, "lane": { "$ref": "#/$defs/id" }, "priority_group": { "type": "integer", "minimum": 1, "maximum": 4 }, "planned_disposition": { "enum": ["execute", "reuse", "blocked"] }, "new_execution": { "type": "boolean" }, "resource_claims": { "type": "array", "minItems": 1, "items": { "type": "object" } } },
  "$defs": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
