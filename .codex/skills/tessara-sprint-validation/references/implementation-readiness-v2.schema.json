{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/implementation-readiness-v2.json",
  "title": "Tessara implementation readiness result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_version", "sprint", "state", "authoritative", "source_identity", "validation_contract", "validation_adapter", "platform_identity", "affected_domains", "changed_paths", "fanout", "targets", "slices", "harvested_defects", "known_failure_count", "materialization", "cleanup_restoration", "evidence_index"],
  "properties": {
    "schema_version": { "const": 2 },
    "contract": { "const": "tessara.implementation-readiness-result" },
    "policy_version": { "const": "tessara-validation-v3" },
    "sprint": { "type": "string", "minLength": 1 },
    "state": { "enum": ["passed", "failed"] },
    "authoritative": { "const": false },
    "source_identity": { "$ref": "#/$defs/source" },
    "validation_contract": { "$ref": "#/$defs/ref" },
    "validation_adapter": { "$ref": "#/$defs/ref" },
    "platform_identity": { "$ref": "#/$defs/platform" },
    "affected_domains": { "$ref": "#/$defs/ids" },
    "changed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "fanout": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["edge", "state", "receipt"], "properties": { "edge": { "$ref": "#/$defs/id" }, "state": { "enum": ["passed", "failed"] }, "receipt": { "$ref": "#/$defs/ref" } } } },
    "targets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "state", "source_identity", "validation_contract_sha256", "adapter_sha256", "clean_environment", "evidence"], "properties": { "id": { "$ref": "#/$defs/id" }, "state": { "enum": ["passed", "failed", "blocked"] }, "source_identity": { "$ref": "#/$defs/source" }, "validation_contract_sha256": { "$ref": "#/$defs/sha" }, "adapter_sha256": { "$ref": "#/$defs/sha" }, "clean_environment": { "type": "boolean" }, "evidence": { "$ref": "#/$defs/ref" } } } },
    "slices": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "state", "exit_targets", "fanout_edges"], "properties": { "id": { "$ref": "#/$defs/id" }, "state": { "enum": ["passed", "failed", "blocked"] }, "exit_targets": { "$ref": "#/$defs/ids" }, "fanout_edges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } } } },
    "harvested_defects": { "$ref": "#/$defs/ref" },
    "known_failure_count": { "type": "integer", "minimum": 0 },
    "materialization": { "$ref": "#/$defs/materialization" },
    "cleanup_restoration": { "$ref": "#/$defs/state" },
    "evidence_index": { "$ref": "#/$defs/ref" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty"], "properties": { "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "tree": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }, "dirty": { "type": "boolean" }, "branch": { "type": "string" } } },
    "platform": { "type": "object", "additionalProperties": false, "required": ["release_version", "platform_fingerprint"], "properties": { "release_version": { "const": "2.0.0" }, "platform_fingerprint": { "$ref": "#/$defs/sha" } } },
    "state": { "type": "object", "additionalProperties": false, "required": ["required", "state", "evidence"], "properties": { "required": { "type": "boolean" }, "state": { "enum": ["passed", "failed", "blocked", "not_applicable"] }, "evidence": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] } } },
    "materialization": { "type": "object", "additionalProperties": false, "required": ["required", "first_apply", "semantic_no_op", "recovery"], "properties": { "required": { "type": "boolean" }, "first_apply": { "$ref": "#/$defs/state" }, "semantic_no_op": { "$ref": "#/$defs/state" }, "recovery": { "$ref": "#/$defs/state" } } }
  }
}
