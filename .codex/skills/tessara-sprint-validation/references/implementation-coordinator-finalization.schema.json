{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/implementation-coordinator-finalization-v1.json",
  "title": "Tessara implementation coordinator finalization receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_version", "sprint", "state", "schedule_digest", "context_fingerprint", "start", "checkpoint", "defect_batch", "targets", "executed_count", "reused_count", "blocked_count", "failed_count", "open_defect_count", "topology_restoration", "source_identity", "validation_contract", "validation_adapter", "platform_identity"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract": { "const": "tessara.validation.implementation-coordinator-finalization" },
    "policy_version": { "const": "tessara-validation-v3" },
    "sprint": { "$ref": "#/$defs/id" },
    "state": { "enum": ["passed", "failed"] },
    "schedule_digest": { "$ref": "#/$defs/sha" },
    "context_fingerprint": { "$ref": "#/$defs/sha" },
    "start": { "$ref": "#/$defs/ref" },
    "checkpoint": { "$ref": "#/$defs/ref" },
    "defect_batch": { "$ref": "#/$defs/ref" },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["target", "state", "disposition", "receipt"], "properties": { "target": { "$ref": "#/$defs/id" }, "state": { "enum": ["passed", "failed", "blocked"] }, "disposition": { "enum": ["executed", "reused", "blocked"] }, "receipt": { "$ref": "#/$defs/ref" } } } },
    "executed_count": { "type": "integer", "minimum": 0 },
    "reused_count": { "type": "integer", "minimum": 0 },
    "blocked_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "open_defect_count": { "type": "integer", "minimum": 0 },
    "topology_restoration": { "enum": ["passed", "failed", "not_applicable"] },
    "source_identity": { "type": "object" },
    "validation_contract": { "$ref": "#/$defs/ref" },
    "validation_adapter": { "$ref": "#/$defs/ref" },
    "platform_identity": { "$ref": "#/$defs/platform" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha" } } },
    "platform": { "type": "object", "additionalProperties": false, "required": ["release_version", "platform_fingerprint", "execution_fingerprint"], "properties": { "release_version": { "const": "2.0.0" }, "platform_fingerprint": { "$ref": "#/$defs/sha" }, "execution_fingerprint": { "$ref": "#/$defs/sha" } } }
  }
}
