{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/implementation-coordinator-start-v1.json",
  "title": "Tessara immutable implementation coordinator start",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_version", "sprint", "schedule_digest", "context_fingerprint", "source_identity", "validation_contract", "validation_adapter", "platform_identity", "state_input", "ordering", "execution_mode", "schedule", "finalization"],
  "properties": {
    "schema_version": { "const": 1 }, "contract": { "const": "tessara.validation.implementation-coordinator-start" }, "policy_version": { "const": "tessara-validation-v3" },
    "sprint": { "$ref": "#/$defs/id" }, "schedule_digest": { "$ref": "#/$defs/sha" }, "context_fingerprint": { "$ref": "#/$defs/sha" }, "source_identity": { "type": "object" },
    "validation_contract": { "$ref": "#/$defs/ref" }, "validation_adapter": { "$ref": "#/$defs/ref" }, "platform_identity": { "$ref": "#/$defs/platform" }, "state_input": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] },
    "ordering": { "const": "evidentiary-priority-v1" }, "execution_mode": { "const": "serial-resource-safe" },
    "schedule": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
    "finalization": { "type": "object", "additionalProperties": false, "required": ["priority_group", "disposition", "rationale"], "properties": { "priority_group": { "const": 5 }, "disposition": { "const": "finalize" }, "rationale": { "type": "string", "minLength": 1 } } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "path": { "type": "string", "minLength": 1 },
    "ref": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha" } } },
    "platform": { "type": "object", "additionalProperties": false, "required": ["release_version", "platform_fingerprint", "execution_fingerprint"], "properties": { "release_version": { "const": "2.0.0" }, "platform_fingerprint": { "$ref": "#/$defs/sha" }, "execution_fingerprint": { "$ref": "#/$defs/sha" } } },
    "fingerprints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["domain", "sha256"], "properties": { "domain": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha" }, "file_count": { "type": "integer", "minimum": 0 } } } },
    "claim": { "type": "object", "additionalProperties": false, "required": ["kind", "identity", "mode"], "properties": { "kind": { "enum": ["evidence-path", "topology", "port", "database", "docker", "process", "external-service"] }, "identity": { "$ref": "#/$defs/id" }, "mode": { "const": "exclusive" } } },
    "entry": { "type": "object", "additionalProperties": false, "required": ["ordinal", "target", "lane", "priority_group", "disposition", "rationale", "prerequisite_closure", "dependency_fingerprints", "compatibility_fingerprint", "command_identity", "environment_fingerprint", "previous_receipt", "provenance", "resource_claims"], "properties": { "ordinal": { "type": "integer", "minimum": 1 }, "target": { "$ref": "#/$defs/id" }, "lane": { "$ref": "#/$defs/id" }, "priority_group": { "type": "integer", "minimum": 1, "maximum": 4 }, "disposition": { "enum": ["execute", "reuse", "blocked"] }, "rationale": { "type": "string", "minLength": 1 }, "prerequisite_closure": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "dependency_fingerprints": { "$ref": "#/$defs/fingerprints" }, "compatibility_fingerprint": { "$ref": "#/$defs/sha" }, "command_identity": { "$ref": "#/$defs/sha" }, "environment_fingerprint": { "$ref": "#/$defs/sha" }, "previous_receipt": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }, "provenance": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }, "resource_claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } } } }
  }
}
