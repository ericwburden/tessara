FROM rust:1.94-bookworm AS builder
WORKDIR /app
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release -p tessara-dashboard-module \
    && cp /app/target/release/tessara-dashboard-module /tmp/dashboard-module

FROM debian:trixie-slim
ARG TESSARA_SOURCE_COMMIT=unknown
ARG TESSARA_SOURCE_TREE=unknown
ARG TESSARA_SOURCE_DIRTY=unknown
ARG TESSARA_DASHBOARD_RELEASE=3.0.0
ARG TESSARA_DASHBOARD_ASSET_DIGEST=sha256:2ed3a77275ca528ce7c9546de084ba5712cca06dc627810492ac0211c262222b

LABEL org.opencontainers.image.revision="$TESSARA_SOURCE_COMMIT" \
      com.tessara.source-tree="$TESSARA_SOURCE_TREE" \
      com.tessara.source-dirty="$TESSARA_SOURCE_DIRTY" \
      com.tessara.build-profile="release" \
      com.tessara.module-definition="tessara.dashboards" \
      com.tessara.module-release="$TESSARA_DASHBOARD_RELEASE" \
      com.tessara.module-asset-digest="$TESSARA_DASHBOARD_ASSET_DIGEST"

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /tmp/dashboard-module /usr/local/bin/dashboard-module
EXPOSE 8091
ENTRYPOINT ["dashboard-module"]
