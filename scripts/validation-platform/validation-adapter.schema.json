{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessara.local/schemas/validation-adapter-v2.json",
  "title": "Tessara Validation Adapter v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "adapter_id",
    "validation_contract_path",
    "acceptance_inputs",
    "fixture_inputs",
    "execution_inputs",
    "execution_policy",
    "lanes"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "contract": { "const": "tessara.validation.adapter" },
    "adapter_id": { "$ref": "#/$defs/id" },
    "validation_contract_path": { "$ref": "#/$defs/repositoryPath" },
    "acceptance_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/laneInput" }
    },
    "execution_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/laneInput" }
    },
    "fixture_inputs": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/laneInput" }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_parallel_lanes", "max_attempts_per_lane", "max_evidence_bytes"],
      "properties": {
        "max_parallel_lanes": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_attempts_per_lane": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_evidence_bytes": { "type": "integer", "minimum": 67108864, "maximum": 4294967296 }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/lane" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "laneInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lanes"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environment"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "environment": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "value": { "type": "string", "maxLength": 4096 },
        "source": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
        "optional": { "type": "boolean" }
      },
      "oneOf": [
        {
          "required": ["value"],
          "not": { "anyOf": [{ "required": ["source"] }, { "required": ["optional"] }] }
        },
        {
          "required": ["source"],
          "not": { "required": ["value"] }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "arguments", "input_paths", "tools"],
      "properties": {
        "program": { "type": "string", "pattern": "^[A-Za-z0-9._+/-]+$" },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "input_paths": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "tools": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tool" } }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program", "input_paths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "program": { "type": "string", "pattern": "^[A-Za-z0-9._+/-]+$" },
        "input_paths": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "timeout_seconds", "protocol"],
      "properties": {
        "port": { "$ref": "#/$defs/id" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "protocol": { "const": "challenge-response-v1" }
      }
    },
    "topology": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider", "on_success"],
          "properties": {
            "mode": { "const": "none" },
            "provider": { "const": "none" },
            "on_success": { "const": "destroy" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider", "ports", "command", "readiness", "on_success"],
          "properties": {
            "mode": { "const": "create" },
            "provider": { "const": "local-process" },
            "ports": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/port" } },
            "command": { "$ref": "#/$defs/command" },
            "readiness": { "$ref": "#/$defs/readiness" },
            "on_success": { "const": "destroy" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "provider", "compose_file", "profiles", "required_services", "ports", "readiness", "provider_identity", "on_success"],
          "properties": {
            "mode": { "enum": ["create", "consume"] },
            "provider": { "const": "docker-compose" },
            "compose_file": { "$ref": "#/$defs/repositoryPath" },
            "profiles": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "required_services": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "ports": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/port" } },
            "readiness": { "$ref": "#/$defs/readiness" },
            "provider_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context", "daemon_id", "server_version", "allowed_images"],
              "properties": {
                "context": { "$ref": "#/$defs/id" },
                "daemon_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$" },
                "server_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
                "allowed_images": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+@sha256:[0-9a-f]{64}$" }
                }
              }
            },
            "on_success": { "enum": ["destroy", "handoff"] },
            "handoff_to": { "$ref": "#/$defs/id" },
            "from_lane": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "stage", "program", "arguments", "input_paths", "tools", "timeout_seconds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "stage": { "const": "setup" },
            "program": { "type": "string", "pattern": "^[A-Za-z0-9._+/-]+$" },
            "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
            "input_paths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
            "tools": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tool" } },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "stage", "implementation_target", "proof_classes", "program", "arguments", "input_paths", "tools", "timeout_seconds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "stage": { "const": "assertion" },
            "implementation_target": { "$ref": "#/$defs/id" },
            "proof_classes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "program": { "type": "string", "pattern": "^[A-Za-z0-9._+/-]+$" },
            "arguments": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 4096 } },
            "input_paths": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
            "tools": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tool" } },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 7200 }
          }
        }
      ]
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prerequisites", "environment", "blocked_environment", "topology", "actions", "deadline_seconds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prerequisites": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "environment": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/environment" } },
        "blocked_environment": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        },
        "deadline_seconds": { "type": "integer", "minimum": 1, "maximum": 14400 },
        "topology": { "$ref": "#/$defs/topology" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  }
}
